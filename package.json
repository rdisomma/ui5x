{
  "name": "@raffaeledisomma/ui5x",
  "version": "0.3.0",
  "description": "An OpenUI5 and SAPUI5 library of composite controls, with theming, accessibility and state handling built in",
  "types": "dist/index.d.ts",
  "main": "index.js",
  "license": "Apache-2.0",
  "author": "Raffaele Di Somma",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdisomma/ui5x.git"
  },
  "bugs": {
    "url": "https://github.com/rdisomma/ui5x/issues"
  },
  "homepage": "https://github.com/rdisomma/ui5x#readme",
  "scripts": {
    "start": "run-p \"interfaces:watch\" \"start:server\"",
    "start:server": "ui5 serve --open test-resources/ui5x/app/index.html",
    "interfaces": "npx @ui5/ts-interface-generator",
    "interfaces:watch": "npx @ui5/ts-interface-generator --watch",
    "typecheck": "tsc --noEmit",
    "test": "karma start karma.conf.js",
    "build": "npm run interfaces && npm run typecheck && ui5 build --clean-dest",
    "package:prepare": "node scripts/prepare-package.mjs",
    "package:pack": "npm run build && npm run package:prepare && npm pack ./dist",
    "package:dry-run": "npm run build && npm run package:prepare && npm pack ./dist --dry-run",
    "demo:site": "npm run build && node scripts/build-demo-site.mjs",
    "demo:serve": "npm run demo:site && npx http-server demo-site -p 8095 -o",
    "start:dist": "ui5 serve --config ui5-dist.yaml --open test-resources/ui5x/Skeleton.html",
    "test:unit:browser": "ui5 serve --open test-resources/ui5x/qunit/unitTests.qunit.html",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ui5",
    "openui5",
    "sapui5",
    "skeleton",
    "loading",
    "ux",
    "controls",
    "typescript"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@openui5/types": "^1.151.0",
    "@types/qunit": "^2.19.14",
    "@ui5/cli": "^4.0.62",
    "@ui5/ts-interface-generator": "^0.11.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-ui5": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "6.0.3",
    "ui5-tooling-transpile": "^3.13.0"
  }
}
