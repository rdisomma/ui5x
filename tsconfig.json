{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "ui5x/test/*": [
        "./test/ui5x/*"
      ],
      "ui5x/*": [
        "./src/ui5x/*"
      ]
    },
    "types": [
      "@openui5/types",
      "@types/qunit"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}