<mvc:View
    controllerName="ui5x.test.app.controller.Base"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ui5x="ui5x.layout"
    height="100%">

    <Page showHeader="false" class="sapUiContentPadding">
        <ui5x:Accordion
            width="{settings>/accordion/width}"
            multipleExpansion="{settings>/accordion/multipleExpansion}"
            items="{accordion>/sections}">

            <ui5x:items>
                <ui5x:AccordionItem
                    title="{accordion>title}"
                    expanded="{accordion>expanded}"
                    enabled="{settings>/accordion/itemsEnabled}">

                    <Text text="{accordion>text}" />
                </ui5x:AccordionItem>
            </ui5x:items>
        </ui5x:Accordion>
    </Page>
</mvc:View>
