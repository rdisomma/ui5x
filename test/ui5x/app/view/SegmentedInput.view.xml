<mvc:View
    controllerName="ui5x.test.app.controller.Base"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ui5x="ui5x.input"
    height="100%">

    <Page showHeader="false" class="sapUiContentPadding">
        <VBox>
            <Label text="One-time code" labelFor="code" />

            <ui5x:SegmentedInput
                id="code"
                digits="{settings>/segmentedInput/digits}"
                inputType="{settings>/segmentedInput/inputType}"
                size="{settings>/segmentedInput/size}"
                showSeparators="{settings>/segmentedInput/showSeparators}"
                separatorInterval="{settings>/segmentedInput/separatorInterval}"
                value="{settings>/segmentedInput/value}"
                valueState="{settings>/segmentedInput/valueState}"
                valueStateText="{settings>/segmentedInput/valueStateText}"
                showClearIcon="{settings>/segmentedInput/showClearIcon}"
                enabled="{settings>/segmentedInput/enabled}"
                editable="{settings>/segmentedInput/editable}"
                required="{settings>/segmentedInput/required}" />
        </VBox>
    </Page>
</mvc:View>
