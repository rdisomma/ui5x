<mvc:View
    controllerName="ui5x.test.app.controller.Base"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ui5x="ui5x.loading"
    height="100%">

    <Page showHeader="false" class="sapUiContentPadding">
        <ui5x:LoadingResponsiveTable
            loading="{settings>/loadingResponsiveTable/loading}"
            skeletonRows="{settings>/loadingResponsiveTable/skeletonRows}"
            maxSkeletonRows="{settings>/loadingResponsiveTable/maxSkeletonRows}"
            skeletonRowsMode="{settings>/loadingResponsiveTable/skeletonRowsMode}"
            skeletonRowHeight="{settings>/loadingResponsiveTable/skeletonRowHeight}"
            dynamicSkeletonWidths="{settings>/loadingResponsiveTable/dynamicSkeletonWidths}"
            animated="{settings>/loadingResponsiveTable/animated}">

            <ui5x:table>
                <Table items="{customers>/rows}" fixedLayout="true">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Customers" level="H3" />
                            <ToolbarSpacer />
                            <SearchField width="14rem" />
                            <Button icon="sap-icon://sort" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column><Text text="Customer" /></Column>
                        <Column><Text text="Company" /></Column>
                        <Column><Text text="Status" /></Column>
                        <Column hAlign="End"><Text text="Revenue" /></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{customers>name}" />
                                <Text text="{customers>company}" />
                                <ObjectStatus text="{customers>status}" state="{customers>state}" />
                                <ObjectNumber number="{customers>amount}" unit="EUR" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ui5x:table>
        </ui5x:LoadingResponsiveTable>
    </Page>
</mvc:View>
