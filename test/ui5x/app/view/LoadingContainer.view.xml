<mvc:View
    controllerName="ui5x.test.app.controller.Base"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ui5x="ui5x.loading"
    height="100%">

    <Page showHeader="false" class="sapUiContentPadding">
        <ui5x:LoadingContainer
            loading="{settings>/loadingContainer/loading}"
            skeletonType="{settings>/loadingContainer/skeletonType}"
            skeletonLines="{settings>/loadingContainer/skeletonLines}">

            <ui5x:content>
                <VBox>
                    <Title text="Project overview" level="H3" />
                    <Text text="Bind loading to the flag your application already has, and the container swaps the placeholder for this content." />
                    <MessageStrip text="Content loaded successfully." type="Information" class="sapUiSmallMarginTop" />
                </VBox>
            </ui5x:content>
        </ui5x:LoadingContainer>
    </Page>
</mvc:View>
