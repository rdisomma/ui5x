<mvc:View
    controllerName="ui5x.test.app.controller.Base"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:ui5x="ui5x.loading"
    height="100%">

    <Page showHeader="false" class="sapUiContentPadding">
        <ui5x:LoadingTable
            loading="{settings>/loadingTable/loading}"
            skeletonRows="{settings>/loadingTable/skeletonRows}"
            maxSkeletonRows="{settings>/loadingTable/maxSkeletonRows}"
            skeletonRowsMode="{settings>/loadingTable/skeletonRowsMode}"
            dynamicSkeletonWidths="{settings>/loadingTable/dynamicSkeletonWidths}"
            animated="{settings>/loadingTable/animated}">

            <ui5x:table>
                <table:Table rows="{customers>/rows}" visibleRowCount="5" selectionMode="None" rowHeight="44">

                    <table:extension>
                        <OverflowToolbar>
                            <Title text="Customers" level="H3" />
                            <ToolbarSpacer />
                            <SearchField width="14rem" />
                            <Button icon="sap-icon://sort" />
                        </OverflowToolbar>
                    </table:extension>

                    <table:columns>
                        <table:Column width="auto" minWidth="200">
                            <Text text="Customer" />
                            <table:template><Text text="{customers>name}" wrapping="false" /></table:template>
                        </table:Column>

                        <table:Column width="auto" minWidth="180">
                            <Text text="Company" />
                            <table:template><Text text="{customers>company}" wrapping="false" /></table:template>
                        </table:Column>

                        <table:Column width="auto" minWidth="140">
                            <Text text="Status" />
                            <table:template><ObjectStatus text="{customers>status}" state="{customers>state}" /></table:template>
                        </table:Column>

                        <table:Column width="auto" minWidth="140" hAlign="End">
                            <Text text="Revenue" />
                            <table:template><ObjectNumber number="{customers>amount}" unit="EUR" /></table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </ui5x:table>
        </ui5x:LoadingTable>
    </Page>
</mvc:View>
