<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Popover
        title="LoadingTable settings"
        contentWidth="26rem"
        placement="Bottom"
        class="sapUiSizeCompact">

        <List>
            <InputListItem label="Show the placeholder">
                <Switch state="{settings>/loadingTable/loading}" />
            </InputListItem>

            <InputListItem label="How many rows">
                <Select selectedKey="{settings>/loadingTable/skeletonRowsMode}" width="11rem">
                    <core:Item key="Fixed" text="A fixed number" />
                    <core:Item key="Fill" text="As many as fit" />
                </Select>
            </InputListItem>

            <InputListItem label="Number of rows">
                <StepInput value="{settings>/loadingTable/skeletonRows}" min="1" max="10" width="6rem" />
            </InputListItem>

            <InputListItem label="Most rows when filling">
                <StepInput value="{settings>/loadingTable/maxSkeletonRows}" min="1" max="20" width="6rem" />
            </InputListItem>

            <InputListItem label="Vary the placeholder widths">
                <Switch state="{settings>/loadingTable/dynamicSkeletonWidths}" />
            </InputListItem>

            <InputListItem label="Shimmer animation">
                <Switch state="{settings>/loadingTable/animated}" />
            </InputListItem>
        </List>

        <endButton>
            <Button text="Reset" press=".onResetSettings" />
        </endButton>
    </Popover>
</core:FragmentDefinition>
