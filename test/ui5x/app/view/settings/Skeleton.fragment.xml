<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Popover
        title="Skeleton settings"
        contentWidth="24rem"
        placement="Bottom"
        class="sapUiSizeCompact">

        <List>
            <InputListItem label="Show the three shapes together">
                <Switch state="{settings>/skeleton/composite}" />
            </InputListItem>

            <InputListItem label="Shape">
                <Select selectedKey="{settings>/skeleton/type}" width="9rem">
                    <core:Item key="Line" text="A line" />
                    <core:Item key="Rectangle" text="A rectangle" />
                    <core:Item key="Circle" text="A circle" />
                </Select>
            </InputListItem>

            <InputListItem label="Number of lines">
                <StepInput value="{settings>/skeleton/lines}" min="1" max="3" width="6rem" />
            </InputListItem>

            <InputListItem label="Width">
                <Input textAlign="Begin" value="{settings>/skeleton/width}" width="9rem" />
            </InputListItem>

            <InputListItem label="Shimmer animation">
                <Switch state="{settings>/skeleton/animated}" />
            </InputListItem>
        </List>

        <endButton>
            <Button text="Reset" press=".onResetSettings" />
        </endButton>
    </Popover>
</core:FragmentDefinition>
