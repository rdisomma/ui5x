<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Popover
        title="LoadingContainer settings"
        contentWidth="24rem"
        placement="Bottom"
        class="sapUiSizeCompact">

        <List>
            <InputListItem label="Loading">
                <Switch state="{settings>/loadingContainer/loading}" />
            </InputListItem>

            <InputListItem label="Custom placeholder">
                <Switch state="{settings>/loadingContainer/customPlaceholder}" />
            </InputListItem>

            <InputListItem label="Placeholder shape">
                <Select
                    selectedKey="{settings>/loadingContainer/skeletonType}"
                    enabled="{= !${settings>/loadingContainer/customPlaceholder} }"
                    width="9rem">
                    <core:Item key="Line" text="A line" />
                    <core:Item key="Rectangle" text="A rectangle" />
                    <core:Item key="Circle" text="A circle" />
                </Select>
            </InputListItem>

            <InputListItem label="Number of lines">
                <StepInput value="{settings>/loadingContainer/skeletonLines}" min="1" max="3" width="6rem" />
            </InputListItem>

            <InputListItem label="Shimmer animation">
                <Switch state="{settings>/loadingContainer/animated}" />
            </InputListItem>

            <InputListItem label="Width">
                <Input textAlign="Begin" value="{settings>/loadingContainer/width}" width="9rem" />
            </InputListItem>
        </List>

        <endButton>
            <Button text="Reset" press=".onResetSettings" />
        </endButton>
    </Popover>
</core:FragmentDefinition>
