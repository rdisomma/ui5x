<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Popover
        title="ChatFeed settings"
        contentWidth="26rem"
        placement="Bottom"
        class="sapUiSizeCompact">

        <IconTabBar
            expandable="false"
            applyContentPadding="false"
            selectedKey="behaviour">

            <items>
                <IconTabFilter key="behaviour" text="Behaviour">
                    <List>
                        <InputListItem label="Loading">
                            <Switch state="{settings>/chatFeed/loading}" />
                        </InputListItem>

                        <InputListItem label="Enabled">
                            <Switch state="{settings>/chatFeed/enabled}" />
                        </InputListItem>

                        <InputListItem label="Editable">
                            <Switch state="{settings>/chatFeed/editable}" />
                        </InputListItem>

                        <InputListItem label="Send with the Enter key">
                            <Switch state="{settings>/chatFeed/sendOnEnter}" />
                        </InputListItem>

                        <InputListItem label="Show the send button">
                            <Switch state="{settings>/chatFeed/showSendButton}" />
                        </InputListItem>

                        <InputListItem label="Send button enabled">
                            <Switch state="{settings>/chatFeed/sendButtonEnabled}" />
                        </InputListItem>

                        <InputListItem label="Edit button on messages">
                            <Switch state="{settings>/chatFeed/messagesEditable}" />
                        </InputListItem>

                        <InputListItem label="Delete button on messages">
                            <Switch state="{settings>/chatFeed/messagesDeletable}" />
                        </InputListItem>
                    </List>
                </IconTabFilter>

                <IconTabFilter key="appearance" text="Appearance">
                    <List>
                        <InputListItem label="Highlight your own messages">
                            <Switch state="{settings>/chatFeed/highlightOwnMessage}" />
                        </InputListItem>

                        <InputListItem label="Your messages">
                            <Select selectedKey="{settings>/chatFeed/ownMessageAppearance}" width="9rem">
                                <core:Item key="Bubble" text="A bubble" />
                                <core:Item key="Conversation" text="No bubble" />
                            </Select>
                        </InputListItem>

                        <InputListItem label="Incoming messages">
                            <Select selectedKey="{settings>/chatFeed/incomingMessageAppearance}" width="9rem">
                                <core:Item key="Bubble" text="A bubble" />
                                <core:Item key="Conversation" text="No bubble" />
                            </Select>
                        </InputListItem>

                        <InputListItem label="Messages start from">
                            <Select selectedKey="{settings>/chatFeed/messageAlignment}" width="9rem">
                                <core:Item key="Top" text="The top" />
                                <core:Item key="Bottom" text="The bottom" />
                            </Select>
                        </InputListItem>

                        <InputListItem label="Composer sits at">
                            <Select selectedKey="{settings>/chatFeed/composerPosition}" width="9rem">
                                <core:Item key="Top" text="The top" />
                                <core:Item key="Bottom" text="The bottom" />
                            </Select>
                        </InputListItem>

                        <InputListItem label="Group messages by date">
                            <Switch state="{settings>/chatFeed/groupByDate}" />
                        </InputListItem>

                        <InputListItem label="Timestamp">
                            <Select selectedKey="{settings>/chatFeed/messageTimestampFormat}" width="9rem">
                                <core:Item key="None" text="Hidden" />
                                <core:Item key="Time" text="Time only" />
                                <core:Item key="DateTime" text="Date and time" />
                            </Select>
                        </InputListItem>

                        <InputListItem label="Maximum height">
                            <Input textAlign="Begin" value="{settings>/chatFeed/chatMaxHeight}" width="9rem" />
                        </InputListItem>

                        <InputListItem label="Width">
                            <Input textAlign="Begin" value="{settings>/chatFeed/width}" width="9rem" />
                        </InputListItem>
                    </List>
                </IconTabFilter>

                <IconTabFilter key="text" text="Text">
                    <List>
                        <InputListItem label="Composer placeholder">
                            <Input textAlign="Begin" value="{settings>/chatFeed/placeholder}" width="11rem" />
                        </InputListItem>

                        <InputListItem label="Send button text">
                            <Input textAlign="Begin" value="{settings>/chatFeed/sendButtonText}" width="11rem" />
                        </InputListItem>

                        <InputListItem label="Send button tooltip">
                            <Input textAlign="Begin" value="{settings>/chatFeed/sendButtonTooltip}" width="11rem" />
                        </InputListItem>
                    </List>
                </IconTabFilter>
            </items>
        </IconTabBar>

        <endButton>
            <Button text="Reset" press=".onResetSettings" />
        </endButton>
    </Popover>
</core:FragmentDefinition>
