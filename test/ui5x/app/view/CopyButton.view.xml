<mvc:View
    controllerName="ui5x.test.app.controller.Base"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ui5x="ui5x.button"
    height="100%">

    <Page showHeader="false" class="sapUiContentPadding">
        <HBox alignItems="Center">
            <ui5x:CopyButton
                text="{settings>/copyButton/text}"
                value="{settings>/copyButton/value}"
                icon="{settings>/copyButton/icon}"
                successIcon="{settings>/copyButton/successIcon}"
                type="{settings>/copyButton/type}"
                successType="{settings>/copyButton/successType}"
                successText="{settings>/copyButton/successText}"
                iconFirst="{settings>/copyButton/iconFirst}"
                class="sapUiTinyMarginEnd" />

            <ui5x:CopyButton
                tooltip="Copy value"
                value="{settings>/copyButton/value}"
                icon="{settings>/copyButton/icon}"
                successIcon="{settings>/copyButton/successIcon}"
                type="{settings>/copyButton/type}"
                successType="{settings>/copyButton/successType}"
                successText="{settings>/copyButton/successText}"
                iconFirst="{settings>/copyButton/iconFirst}" />
        </HBox>
    </Page>
</mvc:View>
