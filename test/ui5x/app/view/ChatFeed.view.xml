<mvc:View
    controllerName="ui5x.test.app.controller.ChatFeed"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:ui5x="ui5x.chat"
    height="100%">

    <Page showHeader="false" class="sapUiContentPadding">
        <ui5x:ChatFeed
            value="{settings>/chatFeed/value}"
            placeholder="{settings>/chatFeed/placeholder}"
            enabled="{settings>/chatFeed/enabled}"
            editable="{settings>/chatFeed/editable}"
            loading="{settings>/chatFeed/loading}"
            sendOnEnter="{settings>/chatFeed/sendOnEnter}"
            sendButtonText="{settings>/chatFeed/sendButtonText}"
            sendButtonTooltip="{settings>/chatFeed/sendButtonTooltip}"
            showSendButton="{settings>/chatFeed/showSendButton}"
            sendButtonEnabled="{settings>/chatFeed/sendButtonEnabled}"
            messageTimestampFormat="{settings>/chatFeed/messageTimestampFormat}"
            groupByDate="{settings>/chatFeed/groupByDate}"
            highlightOwnMessage="{settings>/chatFeed/highlightOwnMessage}"
            ownMessageAppearance="{settings>/chatFeed/ownMessageAppearance}"
            incomingMessageAppearance="{settings>/chatFeed/incomingMessageAppearance}"
            composerPosition="{settings>/chatFeed/composerPosition}"
            messageAlignment="{settings>/chatFeed/messageAlignment}"
            chatMaxHeight="{settings>/chatFeed/chatMaxHeight}"
            width="{settings>/chatFeed/width}"
            send=".onSend"
            messageEdit=".onMessageEdit"
            messageDelete=".onMessageDelete"
            messages="{chatFeed>/messages}">

            <ui5x:messages>
                <ui5x:ChatMessage
                    key="{chatFeed>id}"
                    text="{chatFeed>text}"
                    sender="{= ${chatFeed>ownMessage} ? ${settings>/chatFeed/ownSenderName} : ${chatFeed>sender} }"
                    ownMessage="{chatFeed>ownMessage}"
                    editable="{settings>/chatFeed/messagesEditable}"
                    deletable="{settings>/chatFeed/messagesDeletable}"
                    timestamp="{chatFeed>timestamp}" />
            </ui5x:messages>
        </ui5x:ChatFeed>
    </Page>
</mvc:View>
